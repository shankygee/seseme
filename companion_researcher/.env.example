# Companion Researcher Environment Variables

# API Keys (at least one LLM key is recommended)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Search API Keys (optional - enables real web search)
SERPAPI_KEY=your-serpapi-key
TAVILY_API_KEY=tvly-your-tavily-key

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# LLM Settings
DEFAULT_LLM_MODEL=gpt-4o
RESEARCH_LLM_MODEL=gpt-4o
SUMMARIZATION_LLM_MODEL=gpt-4o-mini
TEMPERATURE=0.7
MAX_TOKENS=4096

# Research Settings
MAX_SEARCH_RESULTS=10
MAX_SOURCES_PER_QUERY=5
RESEARCH_TIMEOUT=60

# Voice Settings
ENABLE_VOICE=true
SAMPLE_RATE=24000
